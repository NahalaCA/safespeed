<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/relativeLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_gravity="top|bottom|left|right|center_vertical|fill_vertical|center_horizontal|fill_horizontal|center|fill|start|end"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/startPopupTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left|right|center_horizontal|fill_horizontal|center|fill|start|end"
            android:text="It is recommended to use this app in horizontal mode." />

        <ImageView
            android:id="@+id/horizontalImageView"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_below="@+id/startPopupTextView"
            android:layout_centerHorizontal="true"
            android:background="@drawable/horizontal_mode" />
    </RelativeLayout>
</RelativeLayout>
